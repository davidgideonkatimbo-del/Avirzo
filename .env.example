NODE_ENV=development
PORT=8787
HOST=0.0.0.0
RUNWAYML_API_SECRET=your_runway_secret
ELEVENLABS_API_KEY=your_elevenlabs_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ALLOWED_ORIGINS=http://localhost:5173

# Vite client build-time variables. These are publishable, not secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Production browser origin. In Render, use the public Avirzo URL if ALLOWED_ORIGINS is empty.
AVIRZO_PUBLIC_URL=https://your-app.onrender.com
WORKER_MAX_ATTEMPTS=3

# Optional voice providers
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
