{
  "name": "avirzo",
  "private": true,
  "version": "2.9.3",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\" \"npm run worker -w server\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "verify:production": "node scripts/verify-production.mjs",
    "validate:render": "node scripts/validate-render.mjs",
    "test": "node --test server/test/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2"
}
