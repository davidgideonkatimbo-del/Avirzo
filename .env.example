NODE_ENV=development
PORT=8787
HOST=0.0.0.0
RUNWAYML_API_SECRET=your_runway_secret
ELEVENLABS_API_KEY=your_elevenlabs_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ALLOWED_ORIGINS=http://localhost:5173

# Vite client build-time variables. These are publishable, not secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Production browser origin. In Render, use the public Avirzo URL if ALLOWED_ORIGINS is empty.
AVIRZO_PUBLIC_URL=https://your-app.onrender.com
WORKER_MAX_ATTEMPTS=3

# v2.3 premium voice providers (optional)
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# v2.3 billing (optional until Stripe is enabled)
STRIPE_SECRET_KEY=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Set to true only when the optional avirzo-worker service is running.
AVIRZO_WORKER_ENABLED=false

# Security hardening (optional)
# CSP ships as Content-Security-Policy-Report-Only. After checking the browser console on the live site, set to true to enforce it.
CSP_ENFORCE=false
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_SENSITIVE_PER_10MIN=40

# Free-tier cost controls (defaults: 5 free clips during the free month, 60 Creator and 200 Studio per year, Gen-4.5 for everyone)
FREE_GENERATIONS_PER_YEAR=5
CREATOR_GENERATIONS_PER_YEAR=60
STUDIO_GENERATIONS_PER_YEAR=200
# Set to gen4_turbo to move free accounts to the cheaper model (only used when the scene has a reference image).
FREE_GENERATION_MODEL=

# Free month: free accounts can use generation, voices and performance for this many days, then must subscribe.
# Counted from the later of sign-up and FREE_TRIAL_POLICY_START, so existing accounts also get a full month. 0 = no time limit.
FREE_TRIAL_DAYS=30
FREE_TRIAL_POLICY_START=2026-10-09

# Production credits (creator-funded generation). CREDITS_ENABLED defaults to true in production.
# CREDITS_ENABLED=true
FREE_INCLUDED_CREDITS=25
# Monthly subscription-included production credits (primary cost control)
FREE_CREDITS_PER_MONTH=25
CREATOR_CREDITS_PER_MONTH=300
STUDIO_CREDITS_PER_MONTH=1000
CREDITS_PER_GENERATION=5
CREDITS_PER_VOICE=2
CREDITS_PER_PERFORMANCE=5
# Optional: charge for long exports (0 = free assembly)
CREDITS_PER_EXPORT_MINUTE=0
# Stripe one-time price IDs for credit packs (create products in Stripe Dashboard)
STRIPE_CREDIT_PACK_STARTER_PRICE_ID=
STRIPE_CREDIT_PACK_PRO_PRICE_ID=
STRIPE_CREDIT_PACK_STUDIO_PRICE_ID=
CREDIT_PACK_STARTER_CREDITS=50
CREDIT_PACK_PRO_CREDITS=200
CREDIT_PACK_STUDIO_CREDITS=1000

# Feature / long-form limits (scene count & assembled export length)
FREE_MAX_STORYBOARD_SCENES=24
CREATOR_MAX_STORYBOARD_SCENES=80
STUDIO_MAX_STORYBOARD_SCENES=200
FREE_MAX_EXPORT_SCENES=24
CREATOR_MAX_EXPORT_SCENES=80
STUDIO_MAX_EXPORT_SCENES=200
FREE_MAX_EXPORT_SECONDS=900
CREATOR_MAX_EXPORT_SECONDS=2700
STUDIO_MAX_EXPORT_SECONDS=5400
